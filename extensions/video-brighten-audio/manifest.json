{
  "manifest_version": 3,
  "name": "视频提亮",
  "version": "4.4",
  "description": "点工具栏图标：给网页视频提亮，并放大、拉平声音",
  "permissions": ["storage"],
  "action": {
    "default_title": "视频提亮",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
