{
  "manifest_version": 3,
  "name": "网页媒体下载 · B站 / 小红书 / 通用",
  "version": "1.2.1",
  "description": "识别当前网页可访问的视频和音频资源，并下载支持的媒体文件。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.xhscdn.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "网页媒体下载",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
